# ── Servidor ─────────────────────────────────────────────
PORT=3006

# ── Base de datos (PostgreSQL / Supabase) ────────────────
# Cadena de conexion completa. Requerida.
DATABASE_URL=postgres://user:password@host:5432/dbname

# ── CORS ─────────────────────────────────────────────────
# Lista separada por comas de origenes permitidos. Requerida.
CORS_ORIGIN=http://localhost:5173

# ── Auth (JWT) ───────────────────────────────────────────
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# ── Cotizaciones FX (opcional) ───────────────────────────
# OPEN_ER_API_URL=https://open.er-api.com/v6/latest/ARS
# COINGECKO_RATES_URL=https://api.coingecko.com/api/v3/exchange_rates
# EXCHANGE_RATES_TTL_MS=300000
